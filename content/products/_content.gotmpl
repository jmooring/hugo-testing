{{ range site.Data.products }}

  {{/* Add page. */}}
  {{ $content := dict "mediaType" "text/markdown" "value" .description }}
  {{ $params := dict "sku" .sku "categories" .categories "price" .price }}
  {{ $page := dict
    "content" $content
    "kind" "page"
    "params" $params
    "path" .name
    "title" .name
  }}
  {{ $.AddPage $page }}

  {{/* Add page resource. */}}
  {{ $product := . }}
  {{ range resources.Match (printf "images/products/%s/*.*" .sku) }}
    {{ $content := dict
      "mediaType" .MediaType.Type
      "value" .Content
    }}
    {{ $resource := dict
      "content" $content
      "path" (printf "%s/%s" $product.name (path.Base .Name))
    }}
    {{ $.AddResource $resource }}
  {{ end }}

{{ end }}
